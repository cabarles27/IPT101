<Window x:Class="CabarlesWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Point of Sale System" Height="600" Width="950" Background="#f5f5f5" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Point of Sale System"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10" Padding="15" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Item Name:"/>
                    <ComboBox Text="{Binding SelectedItemName, Mode=TwoWay}" IsEditable="True" Margin="0,5,0,10" Height="30">
                        <ComboBoxItem Content="Coffee"/>
                        <ComboBoxItem Content="Sandwich"/>
                        <ComboBoxItem Content="Cake"/>
                        <ComboBoxItem Content="Juice"/>
                    </ComboBox>

                    <TextBlock Text="Quantity:"/>
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Height="30"/>

                    <TextBlock Text="Price per Item:"/>
                    <TextBox Text="{Binding PricePerItem, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Height="30"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Height="35" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="Clear" Command="{Binding ClearFormCommand}" Height="35" Background="#6c757d" Foreground="White" FontWeight="Bold" Width="80"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" BorderBrush="#DDD" BorderThickness="1" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Current Order" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding OrderItems}" 
                                  SelectedItem="{Binding SelectedOrderItem}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  HeadersVisibility="Column"
                                  Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="Auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding PricePerItem, StringFormat=₱{0:N2}}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=₱{0:N2}}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Actions" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit" 
                                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#ffc107" 
                                                        Foreground="White" 
                                                        Width="50" 
                                                        Height="25" 
                                                        Margin="2"/>
                                                <Button Content="Delete" 
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#dc3545" 
                                                        Foreground="White" 
                                                        Width="60" 
                                                        Height="25" 
                                                        Margin="2"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,15,0,0">
                        <TextBlock Text="Total Amount:" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat=₱{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="#007ACC" HorizontalAlignment="Right" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="New Order" Command="{Binding NewOrderCommand}" Width="100" Margin="5" Background="#6c757d" Foreground="White"/>
                            <Button Content="Pay" Command="{Binding PayCommand}" Width="100" Margin="5" Background="#28a745" Foreground="White"/>
                            <Button Content="Cancel Order" Command="{Binding CancelCommand}" Width="110" Margin="5" Background="#dc3545" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="© 2025 POS System - MVVM + CRUD + SQL Server"
                   HorizontalAlignment="Center"
                   FontSize="12" Foreground="Gray" Margin="0,15,0,0"/>
    </Grid>
</Window>
